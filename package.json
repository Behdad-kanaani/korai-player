{
  "name": "korai-player",
  "version": "1.0.0",
  "description": "KORAI Advanced Music Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "KORAI",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "find-free-port": "^2.0.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^7.14.0",
    "node-id3": "^0.2.9",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
  "appId": "com.korai.player",
  "win": {
    "target": "NSIS",
    "icon": "korai.png"
  },
  "mac": {
    "icon": "korai.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "korai.png"
  }
}
}
