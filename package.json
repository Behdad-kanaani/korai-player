{
  "name": "korai-player",
  "version": "1.6.6",
  "description": "KORAI Player - local-first desktop music library and playback",
  "homepage": "https://github.com/Behdad-kanaani/korai-player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "publish:win": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --mac --linux",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test",
    "audit:static": "node scripts/static-audit.js",
    "check": "npm run audit:static && npm test",
    "plugin": "node scripts/korai-plugin.js"
  },
  "author": {
    "name": "Behdad Kanaani"
  },
  "license": "Apache-2.0 WITH Commons-Clause",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@yawlabs/electron-optimize": "^1.2.0",
    "adm-zip": "^0.5.9",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "find-free-port": "^2.0.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^7.14.0",
    "node-id3": "^0.2.9",
    "semver": "^7.8.1",
    "sharp": "^0.33.5",
    "winston": "^3.9.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.korai.player",
    "productName": "KORAI Player",
    "copyright": "Copyright © 2026 Behdad Kanaani",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "korai.png",
      "korai.ico",
      "src/**/*",
      "!**/*.map",
      "!**/.vscode/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/*.log",
      "!**/.git/**",
      "!README.md",
      "!**/*.md",
      "!**/*.markdown"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Behdad-kanaani",
      "repo": "korai-player",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "korai.ico",
      "fileAssociations": [
        {
          "ext": "mp3",
          "name": "MP3 Audio File",
          "description": "KORAI Music Player - MP3",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "wav",
          "name": "WAV Audio File",
          "description": "KORAI Music Player - WAV",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "flac",
          "name": "FLAC Audio File",
          "description": "KORAI Music Player - FLAC",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "ogg",
          "name": "OGG Audio File",
          "description": "KORAI Music Player - OGG",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "m4a",
          "name": "M4A Audio File",
          "description": "KORAI Music Player - M4A",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "cue",
          "name": "CUE Sheet File",
          "description": "KORAI Music Player - CUE Sheet",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "m3u",
          "name": "M3U Playlist",
          "description": "KORAI Music Player - M3U Playlist",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "m3u8",
          "name": "M3U8 Playlist",
          "description": "KORAI Music Player - M3U8 Playlist",
          "icon": "korai.png",
          "role": "Player"
        },
        {
          "ext": "pls",
          "name": "PLS Playlist",
          "description": "KORAI Music Player - PLS Playlist",
          "icon": "korai.png",
          "role": "Player"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "runAfterFinish": true,
      "artifactName": "KORAI-Player-Setup-${version}.exe",
      "license": "build/license.txt",
      "differentialPackage": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "korai.png",
      "category": "public.app-category.music",
      "fileAssociations": [
        {
          "ext": "mp3",
          "role": "Editor"
        },
        {
          "ext": "wav",
          "role": "Editor"
        },
        {
          "ext": "flac",
          "role": "Editor"
        },
        {
          "ext": "ogg",
          "role": "Editor"
        },
        {
          "ext": "m4a",
          "role": "Editor"
        },
        {
          "ext": "cue",
          "role": "Editor"
        },
        {
          "ext": "m3u",
          "role": "Editor"
        },
        {
          "ext": "m3u8",
          "role": "Editor"
        },
        {
          "ext": "pls",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "korai.png",
      "category": "Audio",
      "fileAssociations": [
        {
          "ext": "mp3",
          "mimeType": "audio/mpeg"
        },
        {
          "ext": "wav",
          "mimeType": "audio/wav"
        },
        {
          "ext": "flac",
          "mimeType": "audio/flac"
        },
        {
          "ext": "ogg",
          "mimeType": "audio/ogg"
        },
        {
          "ext": "m4a",
          "mimeType": "audio/mp4"
        },
        {
          "ext": "cue",
          "mimeType": "text/plain"
        },
        {
          "ext": "m3u",
          "mimeType": "audio/x-mpegurl"
        },
        {
          "ext": "m3u8",
          "mimeType": "audio/x-mpegurl"
        },
        {
          "ext": "pls",
          "mimeType": "audio/x-scpls"
        }
      ]
    },
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/ffmpeg/**"
    ]
  }
}
