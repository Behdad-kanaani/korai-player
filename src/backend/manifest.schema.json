{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "version", "entry"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+\\/[a-zA-Z0-9_.-]+|[a-zA-Z0-9_.-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?$" },
    "entry": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "enum": ["filesystem", "network", "audio", "preferences", "notifications", "clipboard"] },
      "uniqueItems": true
    },
    "grantedPermissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "builtin": { "type": "boolean" },
    "settings": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
